<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agent_dashboard" model="ir.ui.view">
        <field name="name">odoo.agent.dashboard</field>
        <field name="model">odoo.agent</field>
        <field name="arch" type="xml">
            <dashboard>
                <div class="o_dashboard">
                    <div class="o_dashboard_header">
                        <h2>AI Agents Dashboard</h2>
                    </div>

                    <!-- Summary Cards -->
                    <div class="o_dashboard_cards row" style="margin-bottom: 16px;">
                        <div class="col-lg-3 col-md-6">
                            <div class="card text-center">
                                <div class="card-body">
                                    <span class="h1" style="color: #17a2b8;">
                                        <field name="active_task_count" readonly="1"/>
                                    </span>
                                    <p class="card-text">Active Tasks</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card text-center">
                                <div class="card-body">
                                    <span class="h1" style="color: #28a745;">
                                        <field name="active_task_count" readonly="1"/>
                                    </span>
                                    <p class="card-text">Idle Agents</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card text-center">
                                <div class="card-body">
                                    <span class="h1" style="color: #ffc107;">
                                        <field name="active_task_count" readonly="1"/>
                                    </span>
                                    <p class="card-text">Working Agents</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <div class="card text-center">
                                <div class="card-body">
                                    <span class="h1" style="color: #dc3545;">
                                        <field name="active_task_count" readonly="1"/>
                                    </span>
                                    <p class="card-text">Errors</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Agent Status Grid -->
                    <div class="o_dashboard_section">
                        <h3>Agent Status</h3>
                        <field name="name" readonly="1"/>
                        <field name="status" readonly="1"/>
                        <field name="runtime_id" readonly="1"/>
                    </div>
                </div>
            </dashboard>
        </field>
    </record>

    <record id="action_agent_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">odoo.agent</field>
        <field name="view_mode">dashboard</field>
        <field name="help" type="html">
            <p>AI Agent System Dashboard — real-time status overview.</p>
        </field>
    </record>
</odoo>
