<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agent_tree" model="ir.ui.view">
        <field name="name">odoo.agent.tree</field>
        <field name="model">odoo.agent</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="status" widget="badge"/>
                <field name="runtime_id"/>
                <field name="model"/>
                <field name="active_task_count"/>
                <field name="max_concurrent_tasks"/>
            </list>
        </field>
    </record>

    <record id="view_agent_kanban" model="ir.ui.view">
        <field name="name">odoo.agent.kanban</field>
        <field name="model">odoo.agent</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="status"/>
                <field name="runtime_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('odoo.agent', 'avatar', record.id.raw_value)"
                                    alt="Agent" style="width:64px;height:64px;border-radius:50%;"
                                    />
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="status" widget="badge"/>
                                </div>
                                <div t-if="record.runtime_id.raw_value">
                                    Runtime: <field name="runtime_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_agent_form" model="ir.ui.view">
        <field name="name">odoo.agent.form</field>
        <field name="model">odoo.agent</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="badge"
                        />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_agent_task)d" type="action"
                            class="oe_stat_button" icon="fa-tasks">
                            <div class="o_stat_info">
                                <field name="active_task_count"/>
                                <span class="o_stat_text">Active Tasks</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="runtime_id"/>
                            <field name="model"/>
                        </group>
                        <group>
                            <field name="max_concurrent_tasks"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="instructions" string="Instructions">
                            <field name="instructions" nolabel="1"/>
                        </page>
                        <page name="skills" string="Skills">
                            <field name="skill_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="category"/>
                                </list>
                            </field>
                        </page>
                        <page name="tasks" string="Tasks">
                            <field name="task_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="status" widget="badge"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agent_search" model="ir.ui.view">
        <field name="name">odoo.agent.search</field>
        <field name="model">odoo.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="runtime_id"/>
                <filter name="idle" string="Idle"
                    domain="[('status', '=', 'idle')]"/>
                <filter name="working" string="Working"
                    domain="[('status', '=', 'working')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status"
                        context="{'group_by': 'status'}"/>
                    <filter name="group_runtime" string="Runtime"
                        context="{'group_by': 'runtime_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
