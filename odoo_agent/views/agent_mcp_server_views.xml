<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agent_mcp_server_list" model="ir.ui.view">
        <field name="name">odoo.agent.mcp.server.list</field>
        <field name="model">odoo.agent.mcp.server</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="server_key"/>
                <field name="transport"/>
                <field name="command"/>
                <field name="url"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_agent_mcp_server_form" model="ir.ui.view">
        <field name="name">odoo.agent.mcp.server.form</field>
        <field name="model">odoo.agent.mcp.server</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>MCP server tip:</strong>
                        MCP gives agents tools. Treat every server as operational access:
                        configure the command or URL carefully and expose it only to agents that truly need it.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="server_key"/>
                            <field name="transport"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="command"/>
                            <field name="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="description" string="Description">
                            <div class="alert alert-light" role="alert">
                                Describe what tools or data this server exposes and which business process it supports.
                            </div>
                            <field name="description" nolabel="1"/>
                        </page>
                        <page name="args" string="Arguments">
                            <div class="alert alert-light" role="alert">
                                For stdio servers, add one argument per line or a JSON-style list understood by the runtime adapter.
                                Avoid secrets here; use Environment for sensitive values.
                            </div>
                            <field name="args" nolabel="1"/>
                        </page>
                        <page name="environment" string="Environment">
                            <div class="alert alert-light" role="alert">
                                Store environment variables required by the MCP server.
                                Prefer references to runtime-side secrets when possible instead of plain credentials.
                            </div>
                            <field name="environment" nolabel="1"/>
                        </page>
                        <page name="agents" string="Agents">
                            <div class="alert alert-light" role="alert">
                                These agents can use this MCP server during execution.
                                Keep the list small to reduce accidental access to tools or data.
                            </div>
                            <field name="agent_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_agent_mcp_server_search" model="ir.ui.view">
        <field name="name">odoo.agent.mcp.server.search</field>
        <field name="model">odoo.agent.mcp.server</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="server_key"/>
                <field name="transport"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>
</odoo>
